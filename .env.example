# Copy to .env and fill in. Never commit .env.

# --- GCP ---
GCP_PROJECT_ID=steampulse-data-eng
GCS_BUCKET=steampulse-raw-lake
BQ_RAW_DATASET=steam_raw
BQ_RAW_TABLE=gcs_raw_json
BQ_MART_DATASET=dbt_gsinha
GCP_REGION=us-central1

# Path to a service-account key for local runs. On Cloud Run, leave unset and
# use the job's attached service account instead.
GOOGLE_APPLICATION_CREDENTIALS=gcp_keys.json

# --- Ingestion ---
TARGET_GAMES=10000
BATCH_SIZE=10
BATCH_SLEEP=2
NEW_RELEASE_SCAN_PAGES=5
STEAM_COUNTRY_CODE=IN
# Mirror every batch to ./data. Set false on ephemeral compute.
WRITE_LOCAL_BATCHES=true

# Only needed by fetch_list.py (the authenticated app-list helper).
STEAM_API_KEY=

# --- Local Airflow (docker-compose) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
POSTGRES_PASSWORD=airflow
